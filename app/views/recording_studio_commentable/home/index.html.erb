<% content_for :title, RecordingStudio.t("recording_studio.commentable.home.title") %>
<% content_for :subtitle, RecordingStudio.t("recording_studio.commentable.home.subtitle") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: @external_back_path,
  back_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.go_back"),
  anchor_href: @external_back_path,
  anchor_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.close")
) %>

<div class="flex w-full max-w-4xl flex-col gap-8">
  <% if @comment_entries.any? %>
    <div class="flex flex-col gap-4" id="comments">
      <%= render "comments_page",
            comment_entries: @comment_entries,
            page: @page,
            next_page: @next_page %>
    </div>
  <% else %>
    <%= render "recording_studio_commentable/comments/empty_state" %>
  <% end %>
</div>
