<div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: @external_back_path }
  ]) %>

  <%= render FlatPack::Alert::Component.new(style: :success, description: notice) if notice.present? %>
  <%= render FlatPack::Alert::Component.new(style: :danger, description: alert) if alert.present? %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Commentable",
    subtitle: "All comments",
    variant: :h1
  ) %>

  <div class="flex flex-col gap-5" id="comments">
    <% if @comment_entries.any? %>
      <% @comment_entries.each do |entry| %>
        <div class="space-y-2">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-(--surface-muted-content-color)"><%= entry[:parent_title] %></p>
          <%= render "recording_studio_commentable/comments/comment",
                comment_recording: entry[:comment_recording],
                parent_recording: entry[:parent_recording] %>
        </div>
      <% end %>
    <% else %>
      <%= render "recording_studio_commentable/comments/empty_state" %>
    <% end %>
  </div>
</div>