<div class="mx-auto flex w-full max-w-4xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: @external_back_path }
  ]) %>

  <%= render FlatPack::Alert::Component.new(style: :success, description: notice) if notice.present? %>
  <%= render FlatPack::Alert::Component.new(style: :danger, description: alert) if alert.present? %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Commentable",
    subtitle: "All comments",
    variant: :h1
  ) %>

  <% if @comment_entries.any? %>
    <div class="flex flex-col gap-3" id="comments">
      <%= render "comments_page",
            comment_entries: @comment_entries,
            page: @page,
            next_page: @next_page %>
    </div>
  <% else %>
    <%= render "recording_studio_commentable/comments/empty_state" %>
  <% end %>
</div>