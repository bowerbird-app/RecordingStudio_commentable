<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: "RecordingStudio Commentable",
    subtitle: "Threaded comment feeds for Recording Studio recordables. Include the Commentable module to opt a recordable into comments.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Engine mounted", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "FlatPack enabled", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "v#{RecordingStudioCommentable::VERSION}", style: :warning, size: :sm) %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Quick start",
          subtitle: "Three steps to add comments to a recordable.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
          <li>Include <code>RecordingStudioCommentable::Commentable</code> in your recordable model.</li>
          <li>Add <code>recording_studio_commentable</code> to your recordable types in the RecordingStudio initializer.</li>
          <li>Mount the engine in <code>config/routes.rb</code> and link to <code>recording_comments_path(recording)</code>.</li>
        </ol>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Access control",
          subtitle: "Comments respect RecordingStudio access roles.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li><strong>view</strong> role — read the comment feed.</li>
          <li><strong>edit</strong> role — post new comments.</li>
          <li><strong>manage</strong> role — edit or delete any comment.</li>
          <li>Authors may always edit their own comments.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
