<% recording_studio_page_nav(
  title: t("recording_studio.commentable.home.title"),
  page_nav_back_url: @external_back_path,
  page_nav_back_label: t("recording_studio.commentable.navigation.go_back"),
  page_nav_anchor_url: @external_back_path,
  page_nav_anchor_label: t("recording_studio.commentable.navigation.close")
) %>

<div class="flex w-full max-w-4xl flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("recording_studio.commentable.home.title"),
    subtitle: t("recording_studio.commentable.home.subtitle"),
    variant: :h1
  ) %>

  <% if @comment_entries.any? %>
    <div class="flex flex-col gap-4" id="comments">
      <%= render "comments_page",
            comment_entries: @comment_entries,
            page: @page,
            next_page: @next_page %>
    </div>
  <% else %>
    <%= render "recording_studio_commentable/comments/empty_state" %>
  <% end %>
</div>
