<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: (@comments_count.to_i.positive? ? @comments_collection_path : @summary_path) }
  ]) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Add comment",
    subtitle: @page_title,
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <%= render "form",
            comment: @comment,
            url: recording_comments_path(@parent_recording, return_to: params[:return_to]) %>
    <% end %>
  <% end %>
</div>
