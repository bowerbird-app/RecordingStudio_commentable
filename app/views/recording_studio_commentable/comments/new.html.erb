<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: (@comments_count.to_i.positive? ? @comments_collection_path : @summary_path) }
  ]) %>

  <%= render FlatPack::Comments::Thread::Component.new(
    count: @comments_count,
    title: "Add comment",
    empty_title: "",
    empty_body: ""
  ) do |thread| %>
    <% thread.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Add comment",
        subtitle: @page_title,
        variant: :h1,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% thread.comment do %>
      <%= render "form",
            comment: @comment,
          url: main_app.recording_comments_path(@parent_recording, return_to: params[:return_to]),
            cancel_path: (@comments_count.to_i.positive? ? @comments_collection_path : @summary_path),
            force_composer: true %>
    <% end %>
  <% end %>
</div>
