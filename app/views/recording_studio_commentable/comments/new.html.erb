<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: (@safe_return_to_path || (@comments_count.to_i.positive? ? @comments_collection_path : @summary_path)) }
  ]) %>

  <% composer_title = @composer_title.presence || (@parent_comment_recording.present? ? "Reply" : "Add comment") %>
  <% composer_url = @composer_url || main_app.recording_comments_path(@parent_recording, @safe_return_to_path.present? ? { return_to: @safe_return_to_path } : {}) %>

  <%= render FlatPack::Comments::Thread::Component.new(
    count: @comments_count,
    title: composer_title,
    empty_title: "",
    empty_body: ""
  ) do |thread| %>
    <% thread.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: composer_title,
        subtitle: @composer_subtitle.presence || @page_title,
        variant: :h1,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% thread.comment do %>
      <%= render "form",
            comment: @comment,
          url: composer_url,
            parent_comment_id: params[:parent_comment_id],
            force_composer: true %>
    <% end %>
  <% end %>
</div>
