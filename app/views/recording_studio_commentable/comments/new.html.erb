<% composer_title = @composer_title.presence || (@parent_comment_recording.present? ? RecordingStudio.t("recording_studio.commentable.common.reply") : RecordingStudio.t("recording_studio.commentable.common.add_comment")) %>
<% composer_url = @composer_url || commentable_recording_comments_path(@parent_recording, **(@safe_return_to_path.present? ? { return_to: @safe_return_to_path } : {})) %>
<% back_path = @safe_return_to_path || (@comments_count.to_i.positive? ? @comments_collection_path : @summary_path) %>

<% content_for :title, composer_title %>
<% content_for :subtitle, @composer_subtitle.presence || @page_title %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: back_path,
  back_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.go_back"),
  anchor_href: back_path,
  anchor_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.close")
) %>

<div class="flex w-full max-w-3xl flex-col gap-8">
  <%= render FlatPack::Comments::Thread::Component.new(
    count: @comments_count,
    title: composer_title,
    empty_title: "",
    empty_body: ""
  ) do |thread| %>
    <% thread.header do %>
    <% end %>

    <% thread.comment do %>
      <%= render RecordingStudioCommentable::CommentComposer::Component.new(
            comment: @comment,
            url: composer_url,
            parent_comment_id: params[:parent_comment_id]
          ) %>
    <% end %>
  <% end %>
</div>
