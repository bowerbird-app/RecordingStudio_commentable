<%# app/views/recording_studio_commentable/comments/_form.html.erb %>
<% rich_text_comments_enabled = RecordingStudioCommentable.configuration.respond_to?(:rich_text_comments) && RecordingStudioCommentable.configuration.rich_text_comments %>
<%= form_with model: comment, url: url, local: false do |f| %>
  <%= render FlatPack::Alert::Component.new(
    style: :danger,
    description: comment.errors.full_messages.join(", ")
  ) if comment.errors.any? %>

  <div class="flex flex-col gap-4">
    <%= render FlatPack::TextArea::Component.new(
      name: "comment[body]",
      value: comment.body,
      label: "Comment",
      placeholder: "Write your comment…",
      error: comment.errors[:body].first,
      rows: 4,
      rich_text: rich_text_comments_enabled,
      rich_text_options: {
        preset: :content,
        toolbar: :standard,
        format: :html,
        placeholder: "Write your comment…"
      }
    ) %>

    <div class="flex justify-end">
      <%= render FlatPack::Button::Component.new(
        text: comment.new_record? ? "Post comment" : "Save changes",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    </div>
  </div>
<% end %>
