<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: @comments_collection_path }
  ]) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit Comment",
    subtitle: @page_title,
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <%= render "form",
            comment: @comment,
            url: main_app.recording_comment_path(@parent_recording, @comment_recording, return_to: params[:return_to]),
            cancel_path: @comments_collection_path %>
    <% end %>
  <% end %>
</div>
