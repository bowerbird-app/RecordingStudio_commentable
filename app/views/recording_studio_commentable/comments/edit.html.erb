<% content_for :title, RecordingStudio.t("recording_studio.commentable.common.edit_comment") %>
<% content_for :subtitle, @page_title %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: @comments_collection_path,
  back_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.go_back"),
  anchor_href: @comments_collection_path,
  anchor_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.close")
) %>

<div class="flex w-full max-w-3xl flex-col gap-8">
  <%= render FlatPack::Card::Component.new(border: :default, shadow: :none) do |card| %>
    <% card.body do %>
      <%= render RecordingStudioCommentable::CommentComposer::Component.new(
            comment: @comment,
            url: main_app.recording_comment_path(@parent_recording, @comment_recording, @safe_return_to_path.present? ? { return_to: @safe_return_to_path } : {}),
            cancel_path: @comments_collection_path
          ) %>
    <% end %>
  <% end %>
</div>
