<% recording_studio_page_nav(
  title: "Edit comment",
  page_nav_back_url: @comments_collection_path,
  page_nav_back_label: "Go back",
  page_nav_anchor_url: @comments_collection_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full max-w-3xl flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit comment",
    subtitle: @page_title,
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <%= render RecordingStudioCommentable::CommentComposer::Component.new(
            comment: @comment,
            url: main_app.recording_comment_path(@parent_recording, @comment_recording, @safe_return_to_path.present? ? { return_to: @safe_return_to_path } : {}),
            cancel_path: @comments_collection_path
          ) %>
    <% end %>
  <% end %>
</div>
