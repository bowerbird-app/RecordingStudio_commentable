<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::PageNav::Component.new(
    anchor_url: @comments_collection_path,
    anchor_label: "Back"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit Comment",
    subtitle: @page_title,
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <%= render RecordingStudioCommentable::CommentComposer::Component.new(
            comment: @comment,
            url: main_app.recording_comment_path(@parent_recording, @comment_recording, @safe_return_to_path.present? ? { return_to: @safe_return_to_path } : {}),
            cancel_path: @comments_collection_path
          ) %>
    <% end %>
  <% end %>
</div>
