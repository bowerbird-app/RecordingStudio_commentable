<% recording_studio_page_nav(
  title: t("recording_studio.commentable.common.comments"),
  page_nav_back_url: @summary_path,
  page_nav_back_label: t("recording_studio.commentable.navigation.go_back"),
  page_nav_anchor_url: @summary_path,
  page_nav_anchor_label: t("recording_studio.commentable.navigation.close")
) %>

<div class="flex w-full max-w-3xl flex-col gap-8">
  <% show_new_comment_button = ActiveModel::Type::Boolean.new.cast(params[:new_comment_button]) %>

  <% if show_new_comment_button && @can_create_comment %>
    <div class="flex justify-start">
      <%= render FlatPack::Button::Component.new(
            text: t("recording_studio.commentable.common.add_comment"),
            url: @new_comment_path,
            style: :secondary,
            size: :sm,
            class: "justify-start"
          ) %>
    </div>
  <% end %>

  <%= render RecordingStudioCommentable::CommentsFeed::Component.new(
        recording: @parent_recording,
        mode: params[:loading],
        page_size: params[:page_size],
        include_composer: !show_new_comment_button,
        return_to: @safe_return_to_path,
        comment: @comment,
        can_create_comment: @can_create_comment
      ) %>
</div>
