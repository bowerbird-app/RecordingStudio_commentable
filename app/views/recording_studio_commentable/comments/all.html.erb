<% content_for :title, RecordingStudio.t("recording_studio.commentable.common.comments") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: @summary_path,
  back_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.go_back"),
  anchor_href: @summary_path,
  anchor_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.close")
) %>

<div class="flex w-full max-w-3xl flex-col gap-8">
  <% show_new_comment_button = ActiveModel::Type::Boolean.new.cast(params[:new_comment_button]) %>

  <% if show_new_comment_button && @can_create_comment %>
    <% register_page_nav(
      RecordingStudio.t("recording_studio.commentable.common.add_comment"),
      @new_comment_path,
      role: :secondary
    ) %>
  <% end %>

  <%= render RecordingStudioCommentable::CommentsFeed::Component.new(
        recording: @parent_recording,
        mode: params[:loading],
        page_size: params[:page_size],
        include_composer: !show_new_comment_button,
        return_to: @safe_return_to_path,
        comment: @comment,
        can_create_comment: @can_create_comment
      ) %>
</div>
