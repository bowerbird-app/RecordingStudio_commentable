<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    { text: "Back", href: @summary_path }
  ]) %>

  <%= render FlatPack::Alert::Component.new(style: :success, description: notice) if notice.present? %>
  <%= render FlatPack::Alert::Component.new(style: :danger, description: alert) if alert.present? %>

  <div class="flex items-center justify-between gap-4">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Comments",
      subtitle: @page_title,
      variant: :h1,
      class: "mb-0 pb-0"
    ) %>

    <%= link_to @new_comment_path do %>
      <%= render FlatPack::Button::Component.new(
        text: "Add comment",
        style: :secondary,
        size: :md
      ) %>
    <% end %>
  </div>

  <div class="flex flex-col gap-4" id="comments">
    <% if @comments.any? %>
      <% @comments.each do |comment_recording| %>
        <%= render "comment", comment_recording: comment_recording %>
      <% end %>
    <% else %>
      <%= render "empty_state" %>
    <% end %>
  </div>
</div>