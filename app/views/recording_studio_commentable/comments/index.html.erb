<% content_for :title, @page_title %>
<% content_for :subtitle, RecordingStudio.t("recording_studio.commentable.index.subtitle") %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: @back_button_onclick.present? ? nil : @external_back_path,
  back_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.go_back"),
  anchor_href: @external_back_path,
  anchor_tooltip: RecordingStudio.t("recording_studio.commentable.navigation.close")
) %>

<article class="flex w-full max-w-3xl flex-col gap-8">
  <% if @page_body.present? %>
    <section>
      <div class="max-w-none space-y-4 text-lg leading-8 whitespace-pre-wrap text-(--surface-content-color)">
        <p><%= @page_body %></p>
      </div>
    </section>
  <% end %>

  <% unless @show_comments %>
    <footer class="border-t border-(--surface-border-color) pt-8">
      <%= render RecordingStudioCommentable::CommentsButton::Component.new(
        recording: @parent_recording,
        class: "w-full justify-center"
      ) %>
    </footer>
  <% end %>

  <% if @show_comments %>
    <section class="border-t border-(--surface-border-color) pt-8">
      <%= render FlatPack::Comments::Thread::Component.new(
        count: @comments_count,
        title: RecordingStudio.t("recording_studio.commentable.common.comments"),
        empty_title: RecordingStudio.t("recording_studio.commentable.empty.title"),
        empty_body: RecordingStudio.t("recording_studio.commentable.empty.body"),
        id: "comments",
        class: "max-w-none bg-transparent p-0 shadow-none"
      ) do |thread| %>
        <% thread.header do %>
          <div class="flex flex-col gap-6">
            <% if @can_create_comment %>
              <%= render RecordingStudioCommentable::CommentComposer::Component.new(
                    comment: @comment,
                    url: commentable_recording_comments_path(
                      @parent_recording,
                      show_comments: true,
                      inline_composer: true
                    )
                  ) %>
            <% end %>

            <h2 class="text-xl font-bold text-(--comments-thread-title-color)">
              <%= RecordingStudio.t("recording_studio.commentable.common.comments") %> <span class="font-medium text-(--comments-thread-count-color)">(<%= @comments_count %>)</span>
            </h2>
          </div>
        <% end %>

        <% @comments.each do |comment_recording| %>
          <% thread.comment do %>
            <%= render "comment",
                  comment_recording: comment_recording,
                  replies: (@replies || {}).fetch(comment_recording.id, []) %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
</article>
