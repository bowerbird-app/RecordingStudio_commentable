<div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-6 py-10">
  <%= render FlatPack::Breadcrumb::Component.new(items: [
    {
      text: "Back",
      href: @external_back_path,
      onclick: "if (window.history.length > 1) { event.preventDefault(); window.history.back(); }"
    }
  ]) %>

  <%= render FlatPack::Alert::Component.new(style: :success, description: notice) if notice.present? %>
  <%= render FlatPack::Alert::Component.new(style: :danger, description: alert) if alert.present? %>

  <article class="flex flex-col gap-4">
    <header class="space-y-2 border-(--surface-border-color)">
      <%= render FlatPack::PageTitle::Component.new(
        title: @page_title,
        subtitle: "Commentable item",
        variant: :h1,
        class: "mb-0 pb-0"
      ) %>
    </header>

    <% if @page_body.present? %>
      <section>
        <div class="max-w-none space-y-4 text-lg leading-8 whitespace-pre-wrap text-(--surface-content-color)">
          <p><%= @page_body %></p>
        </div>
      </section>
    <% end %>

    <footer class="border-t border-(--surface-border-color) pt-6">
      <%= link_to(@comments_count.positive? ? @comments_collection_path : @new_comment_path) do %>
        <%= render FlatPack::Button::Component.new(
          text: @comments_count.positive? ? "#{@comments_count} Comments" : "Add comment",
          style: :primary,
          size: :lg,
          class: "w-full justify-center"
        ) %>
      <% end %>
    </footer>
  </article>
</div>
