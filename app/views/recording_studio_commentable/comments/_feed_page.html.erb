<%= turbo_frame_tag feed.page_frame_id(page), class: (page.to_i > 1 ? "mt-3" : nil) do %>
  <div class="mt-3 flex flex-col gap-3">
    <% comments.each do |comment_recording| %>
      <%= render "recording_studio_commentable/comments/comment",
            comment_recording: comment_recording,
            parent_recording: feed.recording,
            replies: replies.fetch(comment_recording.id, []) %>
    <% end %>
  </div>

  <% if next_page.present? %>
    <%= turbo_frame_tag feed.page_frame_id(next_page), class: "mt-4" do %>
      <% if feed.loading_mode == :infinite %>
        <div
          class="py-4 text-center text-sm text-(--surface-muted-content-color)"
          data-controller="infinite-scroll"
          data-infinite-scroll-url-value="<%= feed.page_path(next_page) %>"
        >
          <p>Loading more comments...</p>
        </div>
      <% elsif feed.loading_mode == :load_more %>
        <div class="flex justify-center pt-4">
          <%= render FlatPack::Button::Component.new(
            text: "Load more",
            url: feed.page_path(next_page),
            style: :secondary,
            size: :sm,
            data: { turbo_frame: feed.page_frame_id(next_page) }
          ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>