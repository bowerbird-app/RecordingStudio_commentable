<%# app/views/recording_studio_commentable/comments/_comment.html.erb %>
<% configuration = RecordingStudioCommentable.configuration %>
<% rich_text_comments_enabled = configuration.rich_text_comments_enabled? %>
<% comment = comment_recording.try(:recordable) || comment_recording %>
<% parent_recording = local_assigns[:parent_recording] || @parent_recording %>
<% accessible = local_assigns.fetch(:accessible, true) %>
<% replies = local_assigns.fetch(:replies, []) %>
<% allow_reply = local_assigns.fetch(:allow_reply, true) %>
<% default_reply_return_to = request&.fullpath %>
<% reply_button_resolver = local_assigns[:reply_button_resolver] %>
<% reply_action_options = if allow_reply && reply_button_resolver.present?
  reply_button_resolver.call(comment_recording, parent_recording)
elsif allow_reply
  {
    text: "Reply",
    href: recording_studio_commentable.reply_comment_path(
      comment_recording,
      default_reply_return_to.present? ? { return_to: default_reply_return_to } : {}
    ),
    class: "text-sm font-medium text-[var(--color-primary)] hover:underline",
    data: { turbo_frame: "_top" }
  }
else
  nil
end %>
<% author_name = comment.respond_to?(:author_display_name) ? comment.author_display_name : "Anonymous" %>
<% author_avatar_url = comment.respond_to?(:author_avatar_url) ? comment.author_avatar_url : nil %>
<% created_at = comment_recording.respond_to?(:created_at) ? comment_recording.created_at : nil %>
<% body_html = accessible && rich_text_comments_enabled ? FlatPack::RichTextSanitizer.sanitize(comment.body.to_s).html_safe : nil %>
<% body_text = if accessible
  rich_text_comments_enabled ? nil : comment.body.to_s
else
  "Comment hidden"
end %>

<div class="<%= accessible ? "" : "opacity-60" %>">
  <%= render FlatPack::Comments::Item::Component.new(
    author_name: author_name,
    timestamp: created_at&.strftime("%b %-d, %Y at %H:%M"),
    timestamp_iso: created_at&.iso8601,
    body: body_text,
    body_html: body_html,
    avatar: { name: author_name, src: author_avatar_url }
  ) do |item| %>
    <% if accessible %>
      <% item.actions do %>
        <% if reply_action_options.present? %>
          <% if reply_button_resolver.present? %>
            <%= render FlatPack::Button::Component.new(**reply_action_options) %>
          <% else %>
            <%= link_to reply_action_options[:text], reply_action_options[:href], class: reply_action_options[:class], data: reply_action_options[:data] %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if replies.any? %>
    <%# Replies are rendered one level deep by passing an empty replies array.
        This is a deliberate design choice: the engine supports one level of
        threading (top-level comments and their direct replies). Deeper nesting
        is avoided to keep the query strategy simple and the UI scannable. %>
    <div class="ml-8 mt-4 flex flex-col gap-4 border-l-2 border-(--surface-border-color) pl-4">
      <% replies.each do |reply_recording| %>
        <%= render "recording_studio_commentable/comments/comment",
              comment_recording: reply_recording,
              parent_recording: parent_recording,
              accessible: accessible,
              allow_reply: false,
              reply_button_resolver: reply_button_resolver,
              replies: [] %>
      <% end %>
    </div>
  <% end %>
</div>
