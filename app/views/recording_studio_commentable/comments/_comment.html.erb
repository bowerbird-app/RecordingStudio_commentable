<%# app/views/recording_studio_commentable/comments/_comment.html.erb %>
<% configuration = RecordingStudioCommentable.configuration %>
<% rich_text_comments_enabled = configuration.rich_text_comments_enabled? %>
<% comment = comment_recording.respond_to?(:recordable) ? comment_recording.recordable : comment_recording %>
<% parent_recording = local_assigns[:parent_recording] || @parent_recording %>
<% accessible = local_assigns.fetch(:accessible, true) %>
<% author_name = comment.respond_to?(:author_display_name) ? comment.author_display_name : "Anonymous" %>
<% author_avatar_url = comment.respond_to?(:author_avatar_url) ? comment.author_avatar_url : nil %>
<% created_at = comment_recording.respond_to?(:created_at) ? comment_recording.created_at : nil %>
<% body_html = accessible && rich_text_comments_enabled ? FlatPack::RichTextSanitizer.sanitize(comment.body.to_s).html_safe : nil %>
<% body_text = if accessible
  rich_text_comments_enabled ? nil : comment.body.to_s
else
  "Comment hidden"
end %>

<div class="<%= accessible ? "" : "opacity-60" %>">
  <%= render FlatPack::Comments::Item::Component.new(
    author_name: author_name,
    timestamp: created_at&.strftime("%b %-d, %Y at %H:%M"),
    timestamp_iso: created_at&.iso8601,
    body: body_text,
    body_html: body_html,
    avatar: { name: author_name, src: author_avatar_url }
  ) do |item| %>
    <% if accessible %>
      <% item.actions do %>
        <%= link_to "Reply", "#", class: "text-sm font-medium text-[var(--color-primary)] hover:underline" %>
      <% end %>
    <% end %>
  <% end %>
</div>
