<%= render FlatPack::Card::Component.new(style: :default, class: "w-full max-w-md") do |card| %>
  <% card.header do %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Sign in",
      subtitle: "Use a seeded account to try the comment feeds.",
      variant: :h2,
      class: "mb-0 pb-0"
    ) %>
  <% end %>

  <% card.body do %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-6">
        <%= render FlatPack::EmailInput::Component.new(
          name: "user[email]",
          label: "Email",
          value: "admin@admin.com",
          placeholder: "you@example.com"
        ) %>

        <%= render FlatPack::PasswordInput::Component.new(
          name: "user[password]",
          label: "Password",
          value: "Password",
          required: true
        ) %>

        <% if devise_mapping.rememberable? %>
          <%= render FlatPack::Checkbox::Component.new(
            name: "#{resource_name}[remember_me]",
            label: "Remember me"
          ) %>
        <% end %>

        <%= render FlatPack::Button::Component.new(
          text: "Sign in",
          style: :primary,
          size: :md,
          type: "submit",
          class: "w-full justify-center"
        ) %>
      </div>
    <% end %>
  <% end %>

  <% card.footer do %>
    <div class="flex flex-col gap-3">
      <%= render FlatPack::Badge::Component.new(
        text: "Admin: admin@admin.com / Password",
        style: :info,
        size: :sm
      ) %>
      <%= render FlatPack::Badge::Component.new(
        text: "Quinn: quinn@admin.com / Password",
        style: :info,
        size: :sm
      ) %>
      <%= render FlatPack::Badge::Component.new(
        text: "View-only: view@admin.com / Password",
        style: :warning,
        size: :sm
      ) %>
    </div>
  <% end %>
<% end %>
