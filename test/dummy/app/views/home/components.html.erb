<% recording_studio_page_nav(
  title: "Components",
  page_nav_back_url: root_path,
  page_nav_back_label: "Home",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Components",
    subtitle: "A dummy-app reference for reusable RecordingStudioCommentable view components, presented in the same preview-first style FlatPack uses in its own demo app.",
    variant: :h1
  ) %>

  <div class="space-y-12 pb-12">
    <% @component_catalog.each do |component_entry| %>
      <section class="space-y-6">
        <%= render FlatPack::SectionTitle::Component.new(
          title: component_entry[:title],
          subtitle: component_entry[:summary],
          anchor: component_entry[:title].parameterize,
          anchor_link: true
        ) %>

        <section class="space-y-4">
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Examples",
            subtitle: "Live previews and copyable ERB calls.",
            anchor_link: true
          ) %>

          <div class="space-y-6">
            <% component_entry[:examples].each do |example| %>
              <div class="space-y-4">
                <%= render FlatPack::PageTitle::Component.new(
                  title: example[:label],
                  subtitle: "Live preview",
                  variant: :h3,
                  class: "mb-0 pb-0"
                ) %>

                <div class="rounded-xl border border-(--surface-border-color) bg-(--surface-secondary-background-color) p-4">
                  <%= render example[:preview].call %>
                </div>

                <%= render FlatPack::CodeBlock::Component.new(
                  title: example[:label],
                  language: "erb",
                  code: example[:input]
                ) %>
              </div>
            <% end %>
          </div>
        </section>

        <section class="space-y-4">
          <%= render FlatPack::SectionTitle::Component.new(
            title: "Parameters",
            subtitle: "Supported arguments for this component.",
            anchor_link: true
          ) %>

          <%= render FlatPack::Card::Component.new do |card| %>
            <% card.body do %>
              <div class="space-y-4">
                <%= render FlatPack::CodeBlock::Component.new(
                  title: "Signature",
                  language: "ruby",
                  code: component_entry[:signature]
                ) %>

                <div>
                  <p class="mb-2 font-medium text-(--surface-content-color)">Source</p>
                  <p class="font-mono text-xs leading-5 text-(--surface-muted-content-color)">
                    <%= component_entry[:source] %>
                  </p>
                </div>

                <div class="space-y-3">
                <% component_entry[:params].each do |param| %>
                  <div class="rounded-xl border border-(--surface-border-color) px-4 py-3 text-sm leading-6 text-(--surface-content-color)">
                    <p class="font-mono text-xs leading-5 text-(--surface-content-color)"><%= param[:name] %></p>
                    <p class="mt-2"><%= param[:description] %></p>
                  </div>
                <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </section>

        <% if component_entry[:notes].present? %>
          <section class="space-y-4">
            <%= render FlatPack::SectionTitle::Component.new(
              title: "Implementation details",
              subtitle: "Behavior and implementation details to keep in mind.",
              anchor_link: true
            ) %>

            <%= render FlatPack::Card::Component.new do |card| %>
              <% card.body do %>
                <%= render FlatPack::List::Component.new(class: "text-[var(--surface-content-color)]") do %>
                  <% component_entry[:notes].each do |note| %>
                    <%= render FlatPack::List::Item.new do %>
                      <%= note %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          </section>
        <% end %>
      </section>
    <% end %>
  </div>
</div>