<% recording_studio_page_nav(
  title: @workspace&.name || "Comments",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Home"
) %>

<% recording_studio_page_nav_right do %>
  <%= render FlatPack::Button::Component.new(
    text: "Sign out",
    style: :ghost,
    size: :sm,
    url: destroy_user_session_path,
    data: { turbo_method: :delete }
  ) %>
<% end %>

<div class="flex w-full flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: @workspace&.name || "Comments",
    subtitle: "Sign in, pick a page, and try the comment feeds.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(text: "Scenarios", style: :primary, size: :sm, url: scenarios_path) %>
    <%= render FlatPack::Button::Component.new(text: "All comments", style: :secondary, size: :sm, url: "/commentable") %>
    <%= render FlatPack::Button::Component.new(text: "Recordings", style: :secondary, size: :sm, url: recordings_browser_path) %>
    <%= render FlatPack::Button::Component.new(text: "Helpers", style: :ghost, size: :sm, url: helpers_path) %>
    <%= render FlatPack::Button::Component.new(text: "Components", style: :ghost, size: :sm, url: components_path) %>
    <%= render FlatPack::Button::Component.new(text: "Gem routes", style: :ghost, size: :sm, url: gem_routes_path) %>
  </div>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
    <div class="flex flex-col gap-8">
      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Demo accounts",
            subtitle: "Sign in as either user to verify who can comment on which recording.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <div class="space-y-3 text-sm leading-6">
            <p><strong>Current user:</strong> <%= current_user.display_name %> (<%= current_user.email %>)</p>
            <p><strong>Admin:</strong> admin@admin.com / Password</p>
            <p><strong>Quinn:</strong> quinn@admin.com / Password</p>
            <p><strong>View:</strong> view@admin.com / Password</p>
          </div>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Scenario matrix",
            subtitle: "The seeded scenarios now live on /scenarios.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <div class="space-y-4 text-sm leading-6 text-(--surface-content-color)">
            <p>The folder, owner-only pages, and public page scenarios are available on <code>/scenarios</code>.</p>
            <p>Use the seeded accounts here, then open the scenarios page to inspect each comment feed and verify access outcomes.</p>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Workspace state",
          subtitle: "Useful baseline details while exercising the demo.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <dl class="space-y-3 text-sm leading-6">
          <div>
            <dt class="text-(--surface-muted-content-color)">Workspace</dt>
            <dd class="font-medium"><%= @workspace&.name || "Not seeded" %></dd>
          </div>
          <div>
            <dt class="text-(--surface-muted-content-color)">Root recording</dt>
            <dd class="font-mono text-xs"><%= @root_recording&.id || "Missing" %></dd>
          </div>
          <div>
            <dt class="text-(--surface-muted-content-color)">Scenarios on /scenarios</dt>
            <dd class="font-medium"><%= @scenario_recordings.size %></dd>
          </div>
          <div>
            <dt class="text-(--surface-muted-content-color)">Scenario page</dt>
            <dd><%= link_to "/scenarios", scenarios_path, class: "underline" %></dd>
          </div>
        </dl>
      <% end %>
    <% end %>
  </div>
</div>
