<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @workspace&.name || "RecordingStudio Commentable",
    subtitle: "Use this dummy app to validate authentication, root recording setup, and the commentable addon UI.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Template workflow",
          subtitle: "The first things to change when you turn this into a real addon.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-4 text-sm leading-6 text-[var(--surface-content-color)]">
          <li>
            Include <code>RecordingStudioCommentable::Commentable</code> in your recordable model (e.g. <code>Page</code>).
          </li>
          <li>
            Register your recordable types in <code>test/dummy/config/initializers/recording_studio.rb</code>.
          </li>
          <li>
            Mount the engine in routes: <code>mount RecordingStudioCommentable::Engine, at: "/commentable"</code>.
          </li>
          <li>
            Link to the comment feed from any recording: <code>recording_studio_commentable.recording_comments_path(recording)</code>.
          </li>
        </ol>
      <% end %>
    <% end %>

    <div class="flex flex-col gap-6">
      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Workspace state",
            subtitle: "The seeded Recording Studio baseline for local development.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Workspace</dt>
              <dd class="font-medium"><%= @workspace&.name || "Not seeded" %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Root recording</dt>
              <dd class="font-mono text-xs"><%= @root_recording&.id || "Missing" %></dd>
            </div>
            <div>
              <dt class="text-[var(--surface-muted-content-color)]">Signed in as</dt>
              <dd class="font-medium"><%= current_user.email %></dd>
            </div>
          </dl>
        <% end %>
      <% end %>

      <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: "Useful routes",
            subtitle: "Quick links for checking the mounted engine and local app shell.",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <div class="space-y-3 text-sm">
            <p><strong>App home:</strong> <code>/</code></p>
            <p><strong>Recording Studio mount:</strong> <code>/recording_studio</code></p>
            <p><strong>Commentable engine:</strong> <code>/commentable</code></p>
            <p><strong>Health check:</strong> <code>/up</code></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Pages with comment feeds %>
  <% if @page_recordings.any? %>
    <%= render FlatPack::PageTitle::Component.new(
      title: "Pages (commentable)",
      subtitle: "Pages that support comment feeds via RecordingStudioCommentable.",
      variant: :h2
    ) %>

    <div class="grid gap-4 lg:grid-cols-2">
      <% @page_recordings.each do |recording| %>
        <% page = recording.recordable %>
        <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
          <% card.body do %>
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="font-medium"><%= page.title %></p>
                <p class="text-sm text-[var(--surface-muted-content-color)] mt-1"><%= page.body&.truncate(80) %></p>
              </div>
              <%= link_to recording_studio_commentable.recording_comments_path(recording) do %>
                <%= render FlatPack::Button::Component.new(text: "View comments", style: :secondary, size: :sm) %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
