<% recording_studio_page_nav(
  title: "Scenarios",
  page_nav_back_url: root_path,
  page_nav_back_label: "Home",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full flex-col gap-8"
  data-controller="scroll-anchor"
  data-action="submit->scroll-anchor#remember"
  data-scroll-anchor-hash-value="comment-scenarios"
  data-scroll-anchor-offset-value="12"
  data-scroll-anchor-storage-key-value="comment-scenarios-scroll">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Comment scenarios",
    subtitle: "Include Commentable.to on a page to open a comment thread. Folders stay quiet.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Dummy scenarios", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "FlatPack enabled", style: :info, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(text: "v#{RecordingStudioCommentable::VERSION}", style: :warning, size: :sm) %>
  </div>

  <div class="scroll-mt-6" id="comment-scenarios" data-scroll-anchor-target="anchor"></div>

  <div class="grid gap-4 lg:grid-cols-2">
    <% @scenario_recordings.each do |recording| %>
      <% recordable = recording.recordable %>
      <% is_folder = recordable.is_a?(Folder) %>
      <% title = is_folder ? recordable.name : recordable.title %>
      <% body = is_folder ? "Folders are visible in Recording Studio but are not commentable in this addon." : recordable.body %>
      <% actor_name = current_recording_studio_actor.respond_to?(:display_name) ? current_recording_studio_actor.display_name : current_recording_studio_actor.to_s %>
      <% commentable = recordable.class && RecordingStudio.capability_enabled?(:commentable, for: recordable.class) %>
      <% view_access = !defined?(RecordingStudioAccessible) || RecordingStudioAccessible.authorized?(actor: current_recording_studio_actor, recording: recording, role: :view) %>
      <% edit_access = commentable && (!defined?(RecordingStudioAccessible) || RecordingStudioAccessible.authorized?(actor: current_recording_studio_actor, recording: recording, role: :edit)) %>
      <% expectation = if is_folder
        "Accessible in Recording Studio, but folders are not commentable here, so posting fails."
      elsif edit_access
        "Accessible for #{actor_name}. Adding a comment will succeed."
      elsif view_access
        "Accessible for #{actor_name}. They can open the feed, but cannot add a comment."
      else
        "Not accessible for #{actor_name}. Opening the feed or adding a comment will fail."
      end %>
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.header do %>
          <%= render FlatPack::PageTitle::Component.new(
            title: title,
            subtitle: is_folder ? "Folder scenario" : "Page scenario",
            variant: :h3,
            class: "mb-0 pb-0"
          ) %>
        <% end %>

        <% card.body do %>
          <div class="space-y-4">
            <p class="text-sm text-(--surface-muted-content-color)"><%= body %></p>

            <div class="space-y-2 text-sm leading-6">
              <p><strong>Accessible:</strong> <%= view_access ? "Yes" : "No" %></p>
              <p><strong>Commentable:</strong> <%= commentable ? "Yes" : "No" %></p>
              <p><strong>Expected result:</strong> <%= expectation %></p>
            </div>

            <div class="flex flex-wrap gap-2">
              <%= link_to recording_comments_path(recording, return_to: scenarios_path(anchor: "comment-scenarios")) do %>
                <%= render FlatPack::Button::Component.new(text: "Open comment feed", style: :secondary, size: :sm) %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>