<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Commentable",
      subtitle: "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Home",
        href: "/",
        icon: :home
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Recording Studio",
        href: "/recording_studio",
        icon: :dashboard
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Recordings",
        href: "/recordings",
        icon: :file
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Scenario",
        href: "/scenarios",
        icon: :table
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Commentable",
        href: "/commentable",
        icon: :message_circle
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Helpers",
        href: "/helpers",
        icon: :settings
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Components",
        href: "/components",
        icon: :blocks
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Gem routes",
        href: "/gem-routes",
        icon: :git_branch
      ) %>

    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
